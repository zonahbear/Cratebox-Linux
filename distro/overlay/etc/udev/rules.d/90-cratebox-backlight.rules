# Cratebox OS: the keyboard and screen backlight levels are writable by the logged-in user, for
# maclight (the brightness keys); only the level, nothing else in sysfs
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="smc::kbd_backlight", RUN+="/bin/chmod 0666 /sys%p/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod 0666 /sys%p/brightness"
