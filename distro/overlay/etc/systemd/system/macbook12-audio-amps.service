# 12-inch MacBook 2016/2017: with PipeWire doing the speaker volume in software, the ALSA Master and
# PCM controls must sit at 100% (verified). Only runs on MacBook9,1 / MacBook10,1.
[Unit]
Description=Set 12-inch MacBook speaker amps to full
After=sound.target alsa-restore.service alsa-state.service
ConditionPathExists=/sys/class/sound/card0

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'case "$(cat /sys/class/dmi/id/product_name)" in MacBook9,1|MacBook10,1) amixer -c 0 -q set Master 100%% unmute; amixer -c 0 -q set PCM 100%% ;; esac'

[Install]
WantedBy=multi-user.target
